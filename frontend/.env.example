# ============================================================
# TrabalheRemotoBrasil.com - Variáveis de Ambiente (Frontend)
# Copie para .env.local e preencha com as credenciais do Supabase
# ============================================================

# URL do projeto Supabase (Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co

# Anon Key pública do Supabase (segura para uso no cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=SUA_ANON_KEY_AQUI

# URL pública da aplicação (para SEO e OpenGraph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
